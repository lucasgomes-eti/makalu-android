root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_code_style = android_studio
max_line_length = 100
ktlint_function_naming_ignore_when_annotated_with = Composable

[**/src/test/**/*.kt]
ktlint_ignore_back_ticked_identifier = true
